{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "planner",
  "account_id": "d2a4fd9ca1c88b2f1a20db48282ddefd",
  "keep_vars": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "vars": {
    "AUTH_URL": "https://planner.ahmad-2a4.workers.dev",
    "APP_URL": "https://planner.ahmad-2a4.workers.dev",
    "MICROSOFT_GRAPH_SCOPE": "openid profile email offline_access User.Read User.ReadBasic.All Group.Read.All Tasks.Read Files.Read.All Sites.Read.All",
    "SHAREPOINT_SITE_HOSTNAME": "kedansa.sharepoint.com"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b5e12ddbf491414e849059796ccdd141"
    }
  ],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true }
}
